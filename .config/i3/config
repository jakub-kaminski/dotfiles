# Load X resources (clipboard stack depends on the OSC 52 xterm setting in
# ~/.Xresources — disallowedWindowOps with SetSelection allowed). lightdm's
# /etc/X11/Xsession.d hook already merges this at login; this is a dotfiles-tracked
# belt-and-suspenders so OSC 52 copy survives reboots independent of distro files.
exec_always --no-startup-id xrdb -merge ~/.Xresources

# Set CPU cores to performance
exec --no-startup-id bash /home/jakub/Dropbox/sync/homedir/.config/i3/scripts/governors/performance.sh

