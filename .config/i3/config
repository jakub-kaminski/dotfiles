# relaunched under a different desktop name, update this match. Launcher passes
# -FullscreenSystemKeys=0 so i3 keybindings ($mod+h/$mod+l) stay on the host.
for_window [class="TigerVNC Viewer" title="^WHB04B-6"] move container to workspace $ws18s, floating disable, fullscreen enable
exec --no-startup-id ~/.config/i3/scripts/gmktec-vnc.sh

